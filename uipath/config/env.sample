# Sedol Maestro — environment sample
# Copy to backend/.env and fill in real values. DO NOT commit the filled .env.
# Omitting all UIPATH_* values makes the backend run the built-in simulator fallback
# (the Atari → approval → resume flow is logged locally and never stalls).

# ── Required: LLM policy engine (move generation) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional: UiPath Automation Cloud live dispatch ───────────────────────────
# Tenant identity (from your Automation Cloud URL: cloud.uipath.com/{ORG}/{TENANT})
UIPATH_ORG=your-org-name
UIPATH_TENANT=DefaultTenant

# OAuth 2.0 External Application (Confidential).
# Admin → External Applications → Add Application → grant scopes:
#   OR.Jobs  OR.Folders  OR.Execution  OR.Tasks
UIPATH_CLIENT_ID=00000000-0000-0000-0000-000000000000
UIPATH_CLIENT_SECRET=replace-with-client-secret

# Orchestrator folder that holds the published RescueCase process.
# Sent as the X-UIPATH-OrganizationUnitId header.
UIPATH_FOLDER_ID=123456

# ReleaseKey of the published "SedolMaestro.RescueCase" agentic process.
# Orchestrator → Automations → Processes → (process) → ... → copy Release Key.
UIPATH_PROCESS_KEY=00000000-0000-0000-0000-000000000000

# ── Optional: backend base URL that Maestro Service Tasks call back to ─────────
# Store this as an Orchestrator Asset (BackendBaseUrl) too, so the BPMN isn't hard-coded.
BACKEND_BASE_URL=http://localhost:3001
